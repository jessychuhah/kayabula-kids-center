# Supabase transaction-mode pooler for app queries (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase session-mode pooler for Prisma migrations (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Required once to register the first administrator. Use a long random secret.
ADMIN_SETUP_TOKEN=""

# Pesapal (never expose these values in browser code)
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_ENVIRONMENT="sandbox"
PESAPAL_CALLBACK_URL="http://localhost:3000/payment/result"

# Resend approval email delivery and the Vercel scheduled maintenance job.
RESEND_API_KEY=""
EMAIL_FROM=""
CRON_SECRET=""

# Cloudflare R2 S3-compatible storage. Set R2_PUBLIC_BASE_URL to the bucket's public custom domain.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
