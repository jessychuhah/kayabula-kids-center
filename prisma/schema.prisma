generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  contact   String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String
  location            String?
  category            String?
  profileImageUrl     String?
  profileImageKey     String?
  passwordHash        String
  role                String               @default("USER")
  status              String               @default("ACTIVE")
  approvalStatus      String               @default("APPROVED")
  approvedAt          DateTime?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  sessions            AuthSession[]
  donations           Donation[]
  notifications       UserNotification[]
  supportConversation SupportConversation?
  staffMessages       StaffMessage[]
  siteUpdates         SiteUpdate[]
  communityMessages   CommunityMessage[]
  directMessages      DirectMessage[]
  directMemberships   DirectConversationMember[]
  claimedConversations DirectConversation[] @relation("ClaimedDirectConversations")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([role, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Donation {
  id            String   @id @default(cuid())
  reference     String   @unique
  amount        Int
  currency      String
  method        String
  status        String   @default("PENDING")
  providerRef   String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([providerRef])
}

model UserNotification {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               String
  title              String
  message            String
  emailStatus        String    @default("PENDING")
  emailAttempts      Int       @default(0)
  emailLastAttemptAt DateTime?
  emailSentAt        DateTime?
  emailError         String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
}

model SiteSettings {
  id                String   @id @default("default")
  youthSupported    Int      @default(20)
  familiesSupported Int      @default(23)
  villagesReached   Int      @default(10)
  whatsappNumber    String   @default("256760597356")
  updatedAt         DateTime @updatedAt
}

model Advertisement {
  id              String               @id @default(cuid())
  title           String
  handle          String?
  text            String?
  mediaType       String?
  mediaUrl        String?
  mediaKey        String?
  targetUrl       String?
  durationSeconds Int                  @default(8)
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  assets          AdvertisementMedia[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([isActive, sortOrder])
}

model AdvertisementMedia {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  url             String
  objectKey       String?
  mediaType       String        @default("IMAGE")
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([advertisementId, sortOrder])
}

model SupportConversation {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([updatedAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model CommunityMessage {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DirectConversation {
  id          String                     @id @default(cuid())
  channel     String
  pairKey     String                     @unique
  claimedById String?
  claimedBy   User?                      @relation("ClaimedDirectConversations", fields: [claimedById], references: [id], onDelete: SetNull)
  members     DirectConversationMember[]
  messages    DirectMessage[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([channel, updatedAt])
  @@index([claimedById])
}

model DirectConversationMember {
  id             String            @id @default(cuid())
  conversationId String
  conversation  DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime          @default(now())

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model DirectMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation  DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model StaffMessage {
  id         String   @id @default(cuid())
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  senderRole String
  body       String?
  imageUrl   String?
  imageKey   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SiteUpdate {
  id         String            @id @default(cuid())
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  title      String
  body       String
  media      SiteUpdateMedia[]
  createdAt  DateTime          @default(now())

  @@index([createdAt])
}

model SiteUpdateMedia {
  id        String     @id @default(cuid())
  updateId  String
  update    SiteUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  url       String
  objectKey String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([updateId, sortOrder])
}

model PasswordResetOtp {
  id         String   @id @default(cuid())
  email      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}
